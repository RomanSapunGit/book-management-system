DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/books
DB_ECHO=0
LOG_LEVEL=INFO
LOG_FORMAT=json

# Auth — MUST be set in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=changeme-do-not-use-in-prod
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

BULK_IMPORT_CHUNK_SIZE=500
BULK_IMPORT_MAX_ROWS=50000
# 2 MiB. Enforced by MaxBodySizeMiddleware. In production, also set nginx
# `client_max_body_size` to match (primary gate; this is defense-in-depth).
BULK_IMPORT_MAX_BYTES=2097152
BULK_IMPORT_MAX_STORED_ERRORS=1000
AUTH_DUMMY_PASSWORD=dummy-password-for-timing-equalization
IMPORT_RATE_LIMIT_PER_HOUR=5
IMPORT_RATE_WINDOW_SECONDS=3600
